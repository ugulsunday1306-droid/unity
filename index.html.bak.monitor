<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, shrink-to-fit=yes">
  <title>Choyo_Web</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; background: #101014; overflow: hidden; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Apple SD Gothic Neo",
                   "Malgun Gothic", "Noto Sans KR", sans-serif;
      color: #f2f2f5;
    }

    #unity-container { position: absolute; inset: 0; }
    #unity-canvas { width: 100%; height: 100%; display: block; background: #101014; }

    #unity-loading-bar {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      display: none; text-align: center;
    }
    #unity-loading-text { margin-bottom: 10px; font-size: 13px; color: #a0a0ab; }
    #unity-progress-bar-empty {
      width: 240px; height: 6px; border-radius: 3px;
      background: rgba(255,255,255,0.12); overflow: hidden;
    }
    /* width 대신 transform 을 쓴다. width 변경은 레이아웃 재계산을 유발하고,
       Unity 가 매 프레임 호출하는 GetCanvasClientSize 가 그 비용을 뒤집어쓴다. */
    #unity-progress-bar-full {
      width: 100%; height: 100%; background: #6c8cff;
      transform: scaleX(0); transform-origin: left center;
      will-change: transform;
    }

    #unity-warning {
      position: absolute; left: 50%; top: 16px; transform: translateX(-50%);
      z-index: 30; display: none;
    }
    #unity-warning div {
      padding: 10px 14px; border-radius: 8px; margin-bottom: 6px; font-size: 13px;
    }
  </style>
</head>
<body>
  <div id="unity-container">
    <canvas id="unity-canvas" tabindex="-1"></canvas>
  </div>

  <div id="unity-loading-bar">
    <div id="unity-loading-text">불러오는 중…</div>
    <div id="unity-progress-bar-empty"><div id="unity-progress-bar-full"></div></div>
  </div>

  <div id="unity-warning"></div>

  <script>
  (function () {
    var canvas = document.querySelector('#unity-canvas');
    var warningBanner = document.querySelector('#unity-warning');

    function unityShowBanner(msg, type) {
      function updateVisibility() {
        warningBanner.style.display = warningBanner.children.length ? 'block' : 'none';
      }
      var div = document.createElement('div');
      div.innerHTML = msg;
      warningBanner.appendChild(div);
      if (type === 'error') {
        div.style.cssText = 'background:#e57373;color:#fff;';
      } else {
        if (type === 'warning') div.style.cssText = 'background:#e5b769;color:#111;';
        setTimeout(function () { warningBanner.removeChild(div); updateVisibility(); }, 5000);
      }
      updateVisibility();
    }

    // 1 = CSS 픽셀 그대로 렌더 (가장 가볍다). 1.5~2 로 올리면 선명하지만 무거워진다.
    var MAX_DPR = 1;

    // ------------------------------------------------------------------
    //  Build 파일을 어디서 받을지
    //
    //  ''            → 이 페이지와 같은 폴더의 Build/  (GitHub Pages 기본)
    //  R2 공개 URL   → 'https://pub-xxxxxxxx.r2.dev'
    //
    //  R2 를 쓰는 이유: GitHub Pages 는 Content-Encoding 헤더를 설정할 수 없어
    //  브라우저 대신 자바스크립트가 압축을 풀어야 하고, wasm 스트리밍 컴파일도
    //  막힌다. R2 는 객체마다 헤더를 지정할 수 있어 둘 다 해결된다.
    // ------------------------------------------------------------------
    var BUILD_BASE = 'https://pub-d5966e9be35d4b55b7340cc3ea764d6f.r2.dev';

    var buildUrl = BUILD_BASE ? (BUILD_BASE.replace(/\/$/, '') + '/Build') : 'Build';
    var config = {
      arguments: [],
      dataUrl: buildUrl + '/unity.data.br',
      frameworkUrl: buildUrl + '/unity.framework.js.br',
      codeUrl: buildUrl + '/unity.wasm.br',
      streamingAssetsUrl: 'StreamingAssets',
      // 고DPI 화면에서 렌더 해상도가 2~4배로 뛰는 것을 막는다.
      // NiloToon 은 캐릭터 1명당 패스가 11개라 픽셀 수가 곧바로 부하가 된다.
      devicePixelRatio: Math.min(window.devicePixelRatio || 1, MAX_DPR),
      companyName: "UGUL",
      productName: "Choyo_Web",
      productVersion: "1.0.6",
      showBanner: unityShowBanner,
      autoSyncPersistentDataPath: true
    };

    if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
      var meta = document.createElement('meta');
      meta.name = 'viewport';
      meta.content = 'width=device-width, height=device-height, initial-scale=1.0, user-scalable=no, shrink-to-fit=yes';
      document.getElementsByTagName('head')[0].appendChild(meta);
    }

    // 로딩 각 단계에 걸린 시간을 콘솔에 찍는다.
    var T0 = performance.now();
    function mark(label) {
      console.log('%c[LOAD] ' + ((performance.now() - T0) / 1000).toFixed(2) + 's  ' + label,
                  'color:#6c8cff;font-weight:bold');
    }
    mark('시작');

    document.querySelector('#unity-loading-bar').style.display = 'block';

    var script = document.createElement('script');
    script.src = buildUrl + '/unity.loader.js';
    script.onload = function () {
      var marked90 = false;
      createUnityInstance(canvas, config, function (progress) {
        document.querySelector('#unity-progress-bar-full').style.transform = 'scaleX(' + progress + ')';
        if (!marked90 && progress >= 0.9) { marked90 = true; mark('다운로드 90%'); }
      }).then(function (unityInstance) {
        window.unityInstance = unityInstance;
        mark('엔진 준비 완료 (다운로드 + wasm 컴파일 끝)');

        // 오버레이를 즉시 걷는다.
        //   예전에는 "빠른 프레임이 8번 연속" 나올 때까지 기다렸는데,
        //   오버레이가 살아있는 동안 레이아웃 재계산이 계속 일어나 프레임이
        //   느려지고, 그래서 조건이 영원히 만족되지 않는 고리가 생겼다.
        //   DOM 에서 완전히 제거해야 레이아웃 계산 대상에서 빠진다.
        var bar = document.querySelector('#unity-loading-bar');
        if (bar && bar.parentNode) bar.parentNode.removeChild(bar);
        mark('화면 표시 시작');
      }).catch(function (message) {
        unityShowBanner(message, 'error');
      });
    };
    document.body.appendChild(script);
  })();
  </script>
</body>
</html>
